{
  "name": "grafetto",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @grafetto/web dev",
    "dev:server": "pnpm --filter @grafetto/server dev",
    "build": "pnpm --filter @grafetto/shared build && pnpm --filter @grafetto/web build",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present run typecheck && pnpm run typecheck:e2e && pnpm run typecheck:scripts && pnpm --filter @grafetto/web run typecheck:storybook",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "lint": "pnpm --filter @grafetto/web lint",
    "lint:fix": "pnpm --filter @grafetto/web lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "map": "tsx scripts/archmap/build.ts",
    "map:check": "tsx scripts/archmap/check.ts",
    "map:rules": "depcruise apps packages --ignore-known --output-type err-long",
    "postinstall": "pnpm --filter @grafetto/shared build",
    "storybook": "pnpm --filter @grafetto/web storybook",
    "build-storybook": "pnpm --filter @grafetto/web build-storybook"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dependency-cruiser": "^17.4.3",
    "jscpd": "^5.1.2",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0",
    "esbuild": "0.28.1",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "@types/node": "^24.13.2",
    "vite": "^8.1.0",
    "@grafetto/shared": "workspace:*",
    "@types/ws": "^8.18.1",
    "fflate": "^0.8.3",
    "sharp": "0.35.3",
    "socket.io-client": "^4.8.3",
    "ws": "^8.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "packageManager": "pnpm@10.28.2"
}
