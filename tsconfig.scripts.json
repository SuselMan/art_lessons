{
  // The map generator lives outside every workspace — it reads all of them — so nothing else
  // typechecks it. Same reasoning as tsconfig.e2e.json: a tool that guards the architecture is
  // worth nothing if it quietly stops compiling.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts"]
}
