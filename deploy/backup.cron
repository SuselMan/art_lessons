# (#315) Nightly Postgres backup. Installed into /etc/cron.d by deploy.sh on
# every deploy, so editing the schedule here and pushing is enough — no copying
# by hand, and no drift between what the repo says and what the box does.
#
# 03:20 UTC: after any realistic lesson has ended, and well before the 07:00
# UTC backup check (.github/workflows/backup-check.yml) asks whether it worked.
# Runs as `deploy` — the user already in the `docker` group, owning both
# /var/backups/art-lessons and the rclone config.
#
# Output goes to the journal rather than cron's local mail, which nobody reads:
#   sudo journalctl -t grafetto-backup --since -3d
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

20 3 * * * deploy /bin/bash /opt/art-lessons/deploy/backup.sh 2>&1 | /usr/bin/logger -t grafetto-backup
