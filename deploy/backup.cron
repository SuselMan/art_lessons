# (#315) Nightly Postgres backup — install once with:
#   sudo cp /opt/art-lessons/deploy/backup.cron /etc/cron.d/art-lessons-backup
#   sudo chmod 644 /etc/cron.d/art-lessons-backup
# (cron.d ignores files that are group/world-writable, so the mode matters.)
#
# Unlike everything else under deploy/, this file is NOT picked up by
# deploy.sh's git reset — /etc/cron.d is outside the repo. Editing the schedule
# means copying it again.
#
# 03:20 UTC: after any realistic lesson has ended, and well before the 07:00
# UTC backup check (.github/workflows/backup-check.yml) asks whether it worked.
# Runs as `deploy` — the user already in the `docker` group, owning both
# /var/backups/art-lessons and the rclone config.
#
# Output goes to the journal rather than cron's local mail, which nobody reads:
#   sudo journalctl -t grafetto-backup --since -3d
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

20 3 * * * deploy /bin/bash /opt/art-lessons/deploy/backup.sh 2>&1 | /usr/bin/logger -t grafetto-backup
