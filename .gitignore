node_modules/
dist/
.DS_Store
*.log
*.tsbuildinfo

# Env files with local secrets (DB credentials, JWT signing key) - never commit these
.env
.env.local
.env.*.local
# Written by the deploy workflow into /opt/art-lessons — which is itself a git
# checkout, so an untracked file holding the B2 key sits one `git add -A` away
# from the repo (#315)
backup.env

# IDE
/.idea/

# Auto-created by Agent tool isolation:"worktree" — separate from any
# manually-created sibling worktrees (../pencil-agent-*), which live outside
# this repo entirely and don't need this
/.claude/worktrees/
/temp/

# (#300) Baked paper textures — regenerated by `npm run bake:paper`, and by
# CI on every build. Deliberately not committed: the bake is byte-
# reproducible, and the grid would otherwise add ~60 MB of binary blobs to
# git history permanently, plus that much again on every re-tune.
#
# (#322) The directory, not a `*.paper` glob, and that now matters: the bake
# also writes a manifest.json naming its content-hashed files, and the
# manifest must be ignored with the assets it describes rather than
# committed. A committed manifest would be a claim about a bake nobody can
# check out, and a wrong claim is a 404 — see paperManifest.ts's own comment.
apps/web/public/paper/
