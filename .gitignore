node_modules/
dist/
.DS_Store
*.log
*.tsbuildinfo

# Env files with local secrets (DB credentials, JWT signing key) - never commit these
.env
.env.local
.env.*.local

# IDE
/.idea/

# Auto-created by Agent tool isolation:"worktree" — separate from any
# manually-created sibling worktrees (../pencil-agent-*), which live outside
# this repo entirely and don't need this
/.claude/worktrees/
/temp/

# (#300) Baked paper textures — regenerated by `npm run bake:paper`, and by
# CI on every build. Deliberately not committed: the bake is byte-
# reproducible, and the grid would otherwise add ~60 MB of binary blobs to
# git history permanently, plus that much again on every re-tune.
apps/web/public/paper/
