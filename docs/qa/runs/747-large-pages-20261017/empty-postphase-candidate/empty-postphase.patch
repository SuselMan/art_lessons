+const page={width:7,height:5}
+const support=(rects:Array<{x:number;y:number;width:number;height:number}>)=>{if(!rects.length)return{...page,rect:null,rects};const x=Math.min(...rects.map(r=>r.x)),y=Math.min(...rects.map(r=>r.y)),right=Math.max(...rects.map(r=>r.x+r.width)),top=Math.max(...rects.map(r=>r.y+r.height));return{...page,rect:{x,y,width:right-x,height:top-y},rects}}
