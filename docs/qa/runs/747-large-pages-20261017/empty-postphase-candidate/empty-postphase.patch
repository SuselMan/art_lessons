+it('allocated HALO rather than interior determines zero proof; dry pigment and every channel keep',()=>{const allocated={x:0,y:0,width:5,height:5},raw=support([{x:0,y:0,width:1,height:1}]);expect(emptyM70PostphaseRect(page,allocated,raw)).toBe(false);expect(emptyM70PostphaseRect(page,{x:1,y:1,width:3,height:3},raw)).toBe(true);for(const plane of ['P','C','water','foreign','coverage'])for(let channel=0;channel<4;channel++){const field=new MaterialFieldPages(page),bytes=new Uint8Array(7*5*4);bytes[channel]=1;field.writeRect({x:0,y:0,width:7,height:5},bytes);expect(field.snapshot().readRect(allocated).some(v=>v!==0),plane+channel).toBe(true);expect(emptyM70PostphaseRect(page,allocated,raw)).toBe(false)}})
+it('preserves sparse gaps using authoritative list, and conservatively keeps union-only gap',()=>{const s=support([{x:0,y:0,width:1,height:1},{x:6,y:4,width:1,height:1}]),gap={x:2,y:1,width:2,height:2};expect(emptyM70PostphaseRect(page,gap,s)).toBe(true);expect(emptyM70PostphaseRect(page,gap,{...s,rects:undefined})).toBe(false)})
+it('unknown, nonfinite, inconsistent union/list, out-of-page metadata always keeps',()=>{const rect={x:1,y:1,width:2,height:2};for(const s of [undefined,{}, {...page,rect:undefined},{...page,rect:null,rects:{}},{...page,rect:null,rects:[{x:1,y:1,width:1,height:1}]},{...page,rect:{x:0,y:0,width:7,height:5},rects:[]},{...page,rect:{x:0,y:0,width:7,height:5},rects:[{x:1,y:1,width:1,height:1}]},{...page,rect:{x:-1,y:0,width:1,height:1}},{...page,rect:{x:0,y:0,width:Infinity,height:1}},{...page,width:8,rect:null}])expect(emptyM70PostphaseRect(page,rect,s as any)).toBe(false);for(const bad of [{x:NaN,y:0,width:1,height:1},{x:0,y:0,width:0,height:1},{x:1e20,y:0,width:1,height:1},{x:Number.MAX_SAFE_INTEGER,y:0,width:2,height:1}])expect(emptyM70PostphaseRect(page,bad,support([]))).toBe(false)})
+it('empty captured page skips any valid finite-edge halo without changing coverage storage',()=>{const coverage=new MaterialFieldPages(page);coverage.writeRect({x:0,y:0,width:7,height:5},new Uint8Array(140));const before=coverage.snapshot().readRect({x:0,y:0,width:7,height:5});expect(emptyM70PostphaseRect(page,{x:-27,y:-27,width:61,height:59},support([]))).toBe(true);expect(coverage.snapshot().readRect({x:0,y:0,width:7,height:5})).toEqual(before)})
+it('independent property: skip implies actual CLAMP readRect raw planes entirely zero on odd pages',()=>{let state=739391;const rnd=()=>{state=(Math.imul(state,1664525)+1013904223)>>>0;return state};let skipped=0,kept=0;for(let seed=0;seed<180;seed++){const width=3+rnd()%15,height=3+rnd()%13,size={width,height},rects:Array<{x:number;y:number;width:number;height:number}>=[],fields=Array.from({length:5},()=>new MaterialFieldPages(size));for(const field of fields){const bytes=new Uint8Array(width*height*4);for(let i=0;i<3;i++){const x=rnd()%width,y=rnd()%height;if(rnd()%3===0){bytes[(y*width+x)*4+rnd()%4]=1+rnd()%255;rects.push({x,y,width:1,height:1})}}field.writeRect({x:0,y:0,width,height},bytes)}let union=null;if(rects.length){const x=Math.min(...rects.map(r=>r.x)),y=Math.min(...rects.map(r=>r.y));union={x,y,width:Math.max(...rects.map(r=>r.x+1))-x,height:Math.max(...rects.map(r=>r.y+1))-y}}const meta={...size,rect:union,rects};for(let n=0;n<12;n++){const rect={x:(rnd()%(width+12))-6,y:(rnd()%(height+12))-6,width:1+rnd()%9,height:1+rnd()%9},skip=emptyM70PostphaseRect(size,rect,meta);if(skip){skipped++;for(const field of fields)expect(field.snapshot().readRect(rect).every(v=>v===0)).toBe(true)}else kept++}}expect(skipped).toBeGreaterThan(300);expect(kept).toBeGreaterThan(300)})
