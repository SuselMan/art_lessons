{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // (#246) landing/ is the marketing page; its try-it sheet imports the engine,
  // so it is typechecked with the app rather than left to Vite, which does not.
  "include": ["src", "landing"],
  // The service worker runs in a worker global, not the DOM — it has its own
  // project (tsconfig.sw.json) with the right lib. See that file.
  "exclude": ["src/pwa/sw.ts"]
}
