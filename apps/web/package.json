{
  "name": "@grafetto/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:http": "vite --host --mode http",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "vite preview",
    "prebuild": "tsx scripts/bakePaperTextures.ts --if-missing",
    "postbuild": "tsx scripts/precompressDist.ts",
    "bake:icons": "tsx scripts/bakeAppIcons.ts",
    "bake:paper": "tsx scripts/bakePaperTextures.ts",
    "bake:icon-font": "tsx scripts/bakeIconFont.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@grafetto/shared": "*",
    "@sentry/react": "^10.68.0",
    "@tanstack/react-query": "^5.101.2",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lodash-es": "^4.18.1",
    "nanoid": "^5.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "socket.io-client": "^4.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.4.0",
    "@types/fontkit": "^2.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/subset-font": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.2",
    "fontkit": "^2.0.4",
    "material-symbols": "0.45.9",
    "oxlint": "^1.69.0",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vite-plugin-mkcert": "^1.17.12",
    "vite-plugin-pwa": "^1.3.0"
  }
}
