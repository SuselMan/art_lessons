DATABASE_URL="postgresql://user:password@localhost:5432/art_lessons"
JWT_SECRET="replace-with-a-long-random-string"

# (#177) Optional. Left unset — the normal case for local development — the
# server starts with error reporting disabled and reports nothing at all. In
# production it is handed to the container by the deploy workflow rather than
# stored on the box (see deploy/README.md).
# SENTRY_DSN="https://<key>@<org-id>.ingest.de.sentry.io/<project-id>"
# SENTRY_RELEASE="local"
# SENTRY_ENVIRONMENT="development"
