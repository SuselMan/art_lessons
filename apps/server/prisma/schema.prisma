generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Every browser gets a User row from its first visit on, via a long-lived
// identity cookie (#41) — `email` starts out null (anonymous/guest) and gets
// filled in place the first time this browser signs in, same row, same id. So
// `ownerId` on Room is never optional: anonymous room creation still has a
// real user behind it, just not (yet) a named one. email stays @unique even
// though many guest rows share `null` — Postgres treats NULLs as distinct for
// uniqueness, so this only constrains actual registered emails.
//
// There is no password column (#316): sign-in is a one-time code mailed to
// the address, so the mailbox is the credential and there is nothing else to
// store, forget, or leak.
model User {
  id                String            @id @default(uuid())
  email             String?           @unique
  name              String?
  // Subscription/monetization tier (#5). Gates unrestricted room ownership
  // (paid) vs free-tier limits — orthogonal to per-room roles, which come
  // from Room.ownerId / RoomParticipant, not from account type.
  role              UserRole          @default(FREE)
  ownedRooms        Room[]
  participatedRooms RoomParticipant[]
  roomFolders       RoomFolder[]
  // (#224) Access control back-relations — see the three models at the bottom
  // of this file.
  roomInvitesSent   RoomInvite[]
  roomJoinRequests  RoomJoinRequest[]
  roomBlocks        RoomBlock[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

// One outstanding sign-in code (#316). Not a relation to User on purpose: a
// code is requested by an *address*, and the address may not have an account
// yet — asking for a code is how an account gets created in the first place.
//
// Stored hashed for the same reason a password was: six digits is a million
// possibilities, which a dump of this table turns into an offline search of a
// second or two. The ten-minute TTL doesn't help there — a dump can be taken
// while codes are live.
model LoginCode {
  id           String    @id @default(uuid())
  // Normalized (trimmed + lowercased) by loginCodes.ts before it ever gets
  // here, so lookups can't miss a code because of how someone typed it.
  email        String
  codeHash     String
  // Ties the code to the browser that asked for it (cookie `al_login_nonce`).
  // Without it, a code read aloud to an attacker over the phone is enough to
  // sign in from anywhere — the one attack this flow is actually exposed to.
  requestNonce String
  // Wrong guesses against *this* code. At ATTEMPT_LIMIT the row is burned:
  // a per-code ceiling is what makes six digits safe, since a time-window
  // limit alone lets a patient attacker keep guessing the same live code.
  attempts     Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  // Lookup is always "the newest live code for this address".
  @@index([email, createdAt])
  // Sweeping expired rows: this endpoint takes no credentials, so the table
  // grows with every attempt anyone makes.
  @@index([expiresAt])
}

model Room {
  id           String            @id
  name         String
  paper        String
  // Hex color the creator picked for the paper background (see the shared
  // `Room.paperColor` doc comment) — nullable so pre-existing rows fall back
  // to DEFAULT_PAPER_COLORS[paper] client-side rather than needing a backfill.
  paperColor   String?
  // Infinite (tiled) canvas — canvasWidth/canvasHeight are set iff !infinite.
  // Nullable rather than a sentinel so existing fixed-canvas rows/queries
  // don't need to special-case a magic value; `@default(false)` backfills
  // every pre-existing row as a fixed-canvas room with no data migration.
  infinite     Boolean           @default(false)
  canvasWidth  Int?
  canvasHeight Int?
  passwordHash String?
  // (#224) Who may enter at all. Deliberately independent of `passwordHash`,
  // which stays its own toggle applicable in either mode: the password is a
  // shared secret about the *link*, this is about *people*. A lesson can be
  // invite-only without a password (the allow-list is the gate) or open with
  // one (the secret is the gate) — collapsing them into one setting would
  // make "invite these three students, no password to type on a tablet"
  // unexpressible.
  //
  // Enum rather than a String column (unlike `paper`/`verification`) because
  // this one decides who gets in: a value Postgres cannot hold is a value no
  // join check has to have an opinion about, and there is no fail-open branch
  // to get wrong. Its members are spelled exactly as the wire values in
  // packages/shared's `RoomAccessMode`, so the row travels to the client
  // through `toWireRoom` with no mapping table and no cast.
  //
  // `@default` backfills every existing room as `anyone_with_link` — today's
  // actual behaviour, so the migration changes no room's accessibility.
  accessMode   RoomAccessMode    @default(anyone_with_link)
  closedAt     DateTime?
  // (#317) Fork lineage. `SetNull` rather than the `Cascade` every other
  // relation here uses, and deliberately so: deleting the lesson a student
  // forked from must never delete the student's own work with it. The fork
  // keeps everything it was seeded with — that content lives in its own
  // snapshot and operation rows, not in the parent's — and only forgets
  // where it came from.
  parentRoomId String?
  parent       Room?             @relation("RoomForks", fields: [parentRoomId], references: [id], onDelete: SetNull)
  forks        Room[]            @relation("RoomForks")
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id])
  operations   Operation[]
  participants RoomParticipant[]
  invites      RoomInvite[]
  joinRequests RoomJoinRequest[]
  blocks       RoomBlock[]
  snapshots    RoomLayerSnapshot[]
  layerState   RoomLayerState?
  palette      RoomPalette?
  thumbnail    RoomThumbnail?
  createdAt    DateTime          @default(now())
}

// Persisted join history — one row per (room, user) ever, so "Мои уроки"
// (#116) can list rooms a user was invited into, not just ones they own.
model RoomParticipant {
  id            String      @id @default(uuid())
  roomId        String
  room          Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstJoinedAt DateTime    @default(now())
  lastActiveAt  DateTime    @updatedAt
  // (#211 epic) This room's folder placement for *this* user — folders are
  // per-user organization, not a property of Room, and RoomParticipant is
  // already one row per (room, user) for both owner and guest (see
  // rooms.ts's persistParticipant, called for both). `null` = root level.
  // SetNull on folder delete: folders are pure organizational metadata and
  // never own room data (see RoomFolder below) — deleting one un-files its
  // contents rather than touching the room/participation itself.
  folderId      String?
  folder        RoomFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
}

// (#211 epic, issue #212) Per-user, nestable folder for organizing "Мои
// уроки". Purely organizational metadata (see RoomParticipant.folderId
// above) — never owns a Room, so deleting a folder is always safe data-wise;
// the API layer still restricts delete to empty folders only (no direct
// child rooms or subfolders) to avoid silently reshuffling a user's
// organization (see roomFolderRoutes.ts).
model RoomFolder {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  parentFolderId String?
  parentFolder   RoomFolder?       @relation("RoomFolderChildren", fields: [parentFolderId], references: [id], onDelete: SetNull)
  children       RoomFolder[]      @relation("RoomFolderChildren")
  participants   RoomParticipant[]
  createdAt      DateTime          @default(now())
}

// One row per Operation (@art-lessons/shared) as broadcast over the wire —
// `data` is the full serialized op (source of truth for replay); `type`/
// `layerId`/`tool` are pulled out as their own columns purely for querying
// without parsing JSON. Only `stroke` ops have `tool`, and a few op types
// (layer_delete, operation_revoke/undo/redo) have no `layerId` at all — see
// the `Operation` union in packages/shared — hence both stay nullable.
model Operation {
  id        String   @id
  seq       Int
  type      String
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  layerId   String?
  tool      String?
  data      Json
  createdAt DateTime @default(now())

  @@unique([roomId, seq])
}

// Client-baked snapshot of ONE layer's pixels as of `seq` (#149 epic, made
// per-layer by #370). `data` is the gzip-compressed output of the engine's
// `encodeLayerTiles` — raw RGBA tiles, no image codec anywhere in the path.
//
// One row per layer rather than one bundle per room, and that is the whole
// point (#369). A bundle forced every bake to re-read every layer, which is
// O(layers) of synchronous GPU readback every SNAPSHOT_SEQ_INTERVAL
// operations; worse, a layer the baking client couldn't produce was simply
// left out, and since operations were withheld from clients by a single
// room-wide `latestSnapshotSeq`, a layer missing from the bundle lost its
// content outright. Per-layer rows make the seq a property of the layer:
// `coveredSeq(layer)` is the newest row for it, and everything after that
// stays replayable from the operation log. Not sending a layer then costs
// nothing but a missed optimisation.
//
// `hash` is sha256 of the *decompressed* `data` — used both to dedup (a
// second upload for a (layer, seq) this room already has is discarded) and,
// when SNAPSHOT_VERIFY_DETERMINISM is on, to detect a same-seq upload whose
// pixels don't match what's already stored (a cross-device determinism
// violation — see rooms.ts's saveSnapshot).
model RoomLayerSnapshot {
  id      String @id @default(uuid())
  roomId  String
  room    Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  layerId String
  seq     Int
  data    Bytes
  hash    String
  createdAt DateTime @default(now())
  // (#289 epic, reliable history spec v0.2 §13) Whether this snapshot has
  // been independently corroborated. `unverified` on arrival; `verified`
  // once a second, independently-produced bake of the same seq matched this
  // one's hash; `disputed` if one didn't. Only a `verified` snapshot may
  // ever justify deleting the raw operations it claims to cover — see
  // rooms.ts's pruneOperationsBeforeSnapshot, which now refuses to prune
  // against anything else. `disputed` is deliberately terminal and never
  // auto-resolved: nothing here can tell which of two disagreeing bakes is
  // the correct one, so both stay and the raw operations stay too.
  verification String @default("unverified")

  @@unique([roomId, layerId, seq])
  // Every read is "the newest row for this layer" (coveredSeq) or "the newest
  // row for each layer of this room" (restore) — both are this index.
  @@index([roomId, layerId, seq])
}

// The structural half of a snapshot (#370): which layers exist, their order,
// names, opacity and visibility, as of `seq`.
//
// It used to travel inside each snapshot bundle, because a room-wide seq made
// "pixels and structure as of the same moment" a single fact. With per-layer
// coverage there is no room-wide moment left to attach it to, so it becomes
// what it always was underneath: one current value per room, last write wins.
//
// Kept as a convenience rather than a source of truth. Every operation that
// changes it is structural, and structural operations are resident for a
// room's whole life (see rooms.ts's RESIDENT_OP_TYPES), so a client can
// always rederive this by folding the log — this only saves it the walk.
model RoomLayerState {
  id        String   @id @default(uuid())
  roomId    String   @unique
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seq       Int
  state     Json
  updatedAt DateTime @updatedAt
}

// One row per room (#190 epic) — kept separate from `Room` rather than a
// JSON column on it, since `Room` is otherwise write-once after creation
// (like Operation/RoomLayerSnapshot, everything that actually mutates during a
// session lives in its own table); see packages/shared's DEFAULT_PALETTE_COLORS
// doc comment for why this isn't part of the Operation log instead.
model RoomPalette {
  id        String   @id @default(uuid())
  roomId    String   @unique
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  colors    String[]
  updatedAt DateTime @updatedAt
}

// One row per room (#209), same "kept separate from `Room`" reasoning as
// RoomPalette above — a downscaled composite PNG the client periodically
// POSTs (see thumbnailRoutes.ts) purely so "Мои уроки" room cards (#116) can
// show a preview. Not to be confused with RoomLayerSnapshot (#149 epic): those are
// opaque per-layer tile blobs for fast rejoin, this is a single flat image
// meant to be displayed directly.
model RoomThumbnail {
  id        String   @id @default(uuid())
  roomId    String   @unique
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  data      Bytes
  updatedAt DateTime @updatedAt
}

// (#224, §6 of the release track #314) The allow-list an `invite_only` room
// admits people by. Keyed by **email, not userId**, and that is the point: the
// person a teacher invites usually has no account here yet, and every browser
// already carries a `User` row of its own (see the identity-cookie comment on
// User), so a userId allow-list could only ever list people who had already
// been here. The email is resolved to whoever presents it at join time —
// meaning an invite sent today still admits the student who signs in for the
// first time tomorrow, without the invite needing to be re-issued.
//
// It also means an invite grants nothing to a guest who never signs in: with
// `email` null on their User row there is nothing to match. That is the
// intended trade — an allow-list that anonymous browsers could satisfy would
// not be one.
//
// `email` is stored lowercased/trimmed by the API layer before it ever gets
// here, same rule as LoginCode.email, so an invite typed with capitals still
// matches the address as stored on User.
model RoomInvite {
  id              String   @id @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  email           String
  invitedByUserId String
  // No `onDelete` (Prisma's default Restrict), matching Room.owner rather than
  // the Cascade the room-scoped relations use: cascading here would let a
  // deleted account silently retract access it had granted to other people.
  invitedBy       User     @relation(fields: [invitedByUserId], references: [id])
  createdAt       DateTime @default(now())

  // Re-inviting an address already on the list is a no-op, not a second row —
  // and the check "is this address invited to this room" is this index.
  @@unique([roomId, email])
}

// (#224) Someone who wants into an `invite_only` room and isn't on its
// allow-list. The owner sees these as a queue and approves or denies.
//
// One row per (room, user), not one per request: a denial that spawned a fresh
// row every time would let anyone holding the link grow this table without
// limit, and the owner's queue with it. A repeat ask therefore flips the same
// row back to `pending` (see #226's endpoints), which also keeps "this person
// was already denied once" visible instead of laundering it into a new
// request.
//
// `name` is what the asker typed on the join screen, snapshotted here rather
// than read from User.name: a guest's row often has no name at all, and the
// owner needs something to recognize them by while deciding.
model RoomJoinRequest {
  id          String                @id @default(uuid())
  roomId      String
  room        Room                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  status      RoomJoinRequestStatus @default(pending)
  requestedAt DateTime              @default(now())
  resolvedAt  DateTime?

  @@unique([roomId, userId])
  // The owner-facing read is always "pending requests for this room".
  @@index([roomId, status])
}

// (#224) A revoked participant — the "kick" that sticks. Checked on every
// `join_room` independently of `accessMode`, because the mode a room is in
// says nothing about the one person it was decided must not be in it.
//
// Keyed by userId, which bounds what it can promise: a blocked *guest* who
// clears site data arrives as a new `User` and is no longer recognizably the
// same person. Accepted for the first release rather than papered over —
// blocking is meaningful against signed-in accounts, and a room that needs a
// hard door has `invite_only` and/or a password for that. Anything stronger
// (IP, device fingerprint) would be both weaker than it looks and a privacy
// cost we don't want; recorded here so the limitation isn't rediscovered as a
// bug later.
model RoomBlock {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Every read is "is this user blocked from this room", and blocking twice
  // is the same block.
  @@unique([roomId, userId])
}

enum UserRole {
  FREE
  PRO
  ADMIN
}

// (#224) Members spelled as the wire values on purpose — see Room.accessMode.
enum RoomAccessMode {
  anyone_with_link
  invite_only
}

enum RoomJoinRequestStatus {
  pending
  approved
  denied
}
